# Copy to .env for local development (optional).

# PostgreSQL (Neon, Supabase Session pooler, or Render Postgres):
DATABASE_URL=postgresql://user:password@host.region.provider.com/dbname?sslmode=require

# Set to false only for local Postgres without SSL:
# DATABASE_SSL=false

# Supabase Auth (optional — enables Google sign-in):
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Admin email alerts (optional — Resend)
# Only RESEND_API_KEY is required for new-user signup alerts.
# New-user alerts use onboarding@resend.dev automatically.
RESEND_API_KEY=re_xxxx
ALERT_TO_EMAIL=aravinthsankar12@gmail.com
# ALERT_FROM_EMAIL=alerts@yourdomain.com  # for future non-onboarding alerts
